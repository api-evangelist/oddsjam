{
  "opencollection": "1.0.0",
  "info": {
    "name": "OddsJam Fixtures Grader API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Grader",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Grade futures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/grader/futures"
          },
          "docs": "Grade futures"
        },
        {
          "info": {
            "name": "Grade odds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/grader/odds"
          },
          "docs": "Grade odds"
        },
        {
          "info": {
            "name": "Calculate parlay odds",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.opticodds.com/api/v3/parlay/odds"
          },
          "docs": "Calculate parlay odds"
        }
      ]
    }
  ],
  "bundled": true
}