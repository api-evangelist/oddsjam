{
  "opencollection": "1.0.0",
  "info": {
    "name": "OddsJam Fixtures Tournaments API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tournaments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tournaments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/tournaments"
          },
          "docs": "List tournaments"
        },
        {
          "info": {
            "name": "Get tournament results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/tournaments/results"
          },
          "docs": "Get tournament results"
        }
      ]
    }
  ],
  "bundled": true
}