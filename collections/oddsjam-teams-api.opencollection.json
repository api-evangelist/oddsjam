{
  "opencollection": "1.0.0",
  "info": {
    "name": "OddsJam Fixtures Teams API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/teams"
          },
          "docs": "List teams"
        },
        {
          "info": {
            "name": "List conferences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/conferences"
          },
          "docs": "List conferences"
        },
        {
          "info": {
            "name": "List divisions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/divisions"
          },
          "docs": "List divisions"
        }
      ]
    }
  ],
  "bundled": true
}