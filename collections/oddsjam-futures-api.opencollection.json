{
  "opencollection": "1.0.0",
  "info": {
    "name": "OddsJam Fixtures Futures API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Futures",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List futures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/futures"
          },
          "docs": "List futures"
        },
        {
          "info": {
            "name": "Get futures odds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opticodds.com/api/v3/futures/odds"
          },
          "docs": "Get futures odds"
        }
      ]
    }
  ],
  "bundled": true
}